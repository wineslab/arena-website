# Copy this file to .env and fill in your values.
# .env is loaded automatically by config.py via python-dotenv.

DATABASE_URL=postgresql://localhost/arena

# ── Sessions ──────────────────────────────────────────────────────────────────
# Random secret for signing session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── LDAP authentication ───────────────────────────────────────────────────────
LDAP_HOST=10.100.1.31
LDAP_PORT=636
LDAP_USE_SSL=true
# Verify the server's TLS cert. Off by default (self-signed testbed certs).
LDAP_TLS_VALIDATE=false

# Optional service account for the DN-search bind. Leave blank for anonymous.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# User lookup
LDAP_USER_BASE_DN=ou=Users,dc=sc2,dc=net
LDAP_USERNAME_ATTRIBUTE=uid

# Group / membership lookup
LDAP_GROUP_BASE_DN=dc=sc2,dc=net
LDAP_GROUP_NAME_ATTRIBUTE=cn
LDAP_MEMBER_ATTRIBUTE=uniqueMember
LDAP_MEMBER_ATTRIBUTE_TYPE=dn

# ── RBAC: map LDAP group cn -> role (JSON). admin > editor > viewer. ───────────
ARENA_ROLE_MAP={"admin":["arena-admins","admins"],"editor":["arena-users","users"]}
# Role for an authenticated user matching no group above. Empty = deny.
ARENA_DEFAULT_ROLE=viewer
